# ============================================================================
# VPP Platform — environment variables
# Consolidated from every process.env read in server/ and workers/, plus the
# variables consumed by docker-compose.prod.yml.
#
# Copy to .env and fill in real values. Anything marked [REQUIRED-PROD] has
# `${VAR:?...}` semantics in docker-compose.prod.yml or hard-fails in the
# server when NODE_ENV=production.
# ============================================================================

# ---------------------------------------------------------------------------
# Core server
# ---------------------------------------------------------------------------
NODE_ENV=development                    # production in prod
PORT=3000

# [REQUIRED-PROD] PostgreSQL connection string read by server/db.ts
DATABASE_URL=postgresql://vpp:change-me@localhost:5432/vpp

# [REQUIRED-PROD] Session-signing + encryption key; server refuses to boot in
# production when missing or shorter than 32 chars (server/_core/env.ts)
JWT_SECRET=change-me-min-32-random-chars____________

# OAuth / identity (server/_core/sdk.ts, registerOAuthRoutes)
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
APP_URL=
VITE_APP_URL=
VITE_APP_DOMAIN=
VITE_DEMO_MODE=false

# CORS: comma-separated origins; unset = same-origin only (never use *)
ALLOWED_ORIGINS=
CORS_ORIGIN=
CORS_ORIGINS=

# WebAuthn (server/routers/biometric.ts)
WEBAUTHN_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Redis [REQUIRED-PROD password — redis-server --requirepass in prod compose]
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                         # [REQUIRED-PROD]
REDIS_DB=0

# ---------------------------------------------------------------------------
# PostgreSQL container (docker-compose.prod.yml `postgres` service) and the
# direct-connect workers/orchestrator (DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/
# DB_NAME/DB_SSLMODE - Go orchestrator, Go DR worker, Python workers)
# ---------------------------------------------------------------------------
POSTGRES_DB=vpp
POSTGRES_USER=vpp
POSTGRES_PASSWORD=                      # [REQUIRED-PROD]

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vpp
DB_USER=vpp
DB_PASSWORD=                            # [REQUIRED-PROD]
DB_SSLMODE=require                      # use `disable` only for local dev

# ---------------------------------------------------------------------------
# Keycloak (server keycloak-connect + orchestrator + prod compose)
# ---------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=vpp
KEYCLOAK_CLIENT_ID=vpp-app
KEYCLOAK_CLIENT_SECRET=                 # [REQUIRED-PROD]
KEYCLOAK_SSL_REQUIRED=external
# Admin console credentials for the keycloak container [REQUIRED-PROD]
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=                # [REQUIRED-PROD]
KEYCLOAK_DB_PASSWORD=                   # [REQUIRED-PROD] keycloak-postgresql

# ---------------------------------------------------------------------------
# Temporal (server/workflows + orchestrator + python workers)
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233         # server/workers (host:port)
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_CA_PATH=
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=
TEMPORAL_TLS_SERVER_NAME=

# ---------------------------------------------------------------------------
# Kafka / MQTT / Fluvio
# ---------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=false
KAFKA_SASL_ENABLED=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------------------------------------------------------------------------
# MinIO / S3-compatible storage (server/storage.ts, AWS SDK)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=                        # [REQUIRED-PROD]
MINIO_ROOT_PASSWORD=                    # [REQUIRED-PROD]

# ---------------------------------------------------------------------------
# Grafana (docker-compose.prod.yml override)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                 # [REQUIRED-PROD]

# ---------------------------------------------------------------------------
# Payment gateways — M-Pesa / Airtel / Tigo (server/payment-gateways,
# server/webhooks). Webhook secrets are [REQUIRED-PROD]: unsigned webhooks
# are rejected with 503 in production (server/webhooks/verify-signature.ts)
# ---------------------------------------------------------------------------
PAYMENTS_ENV=sandbox                    # sandbox | production
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_INITIATOR=
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_URL=
MPESA_WEBHOOK_SECRET=                   # [REQUIRED-PROD]

AIRTEL_BASE_URL=
AIRTEL_API_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=KE
AIRTEL_CURRENCY=KES
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CALLBACK_URL=
AIRTEL_WEBHOOK_SECRET=                  # [REQUIRED-PROD]

TIGO_BASE_URL=
TIGO_API_URL=
TIGO_API_KEY=
TIGO_USERNAME=
TIGO_PASSWORD=
TIGO_MERCHANT_CODE=
TIGO_BILLER_CODE=
TIGO_ENVIRONMENT=sandbox
TIGO_CALLBACK_URL=
TIGO_WEBHOOK_SECRET=                    # [REQUIRED-PROD]

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Email (server/_core/emailService.ts)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=
# Africa's Talking SMS (server sms integration)
AT_API_KEY=
AT_USERNAME=
AT_BASE_URL=
# Web push (server push notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# External APIs / integrations
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=
ALLOW_MOCK_WEATHER=false
GRID_OPERATOR_API_KEY=
GRID_OPERATOR_ID=
EDGE_SIGNING_SECRET=
BLOCKCHAIN_NETWORK=
ALERT_WEBHOOK_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Dispatch optimizer (services/optimizer)
# Required in production: without it the server refuses to produce dispatch
# schedules rather than falling back to the rule-based heuristic engine.
# ---------------------------------------------------------------------------
OPTIMIZER_SERVICE_URL=
OPTIMIZER_AUTH_TOKEN=
# Optional: pin an installed solver (e.g. HiGHS, PULP_CBC_CMD, GUROBI_CMD)
OPTIMIZER_SOLVER=

# ---------------------------------------------------------------------------
# docker-compose.prod.yml port overrides
# ---------------------------------------------------------------------------
VPP_SERVER_PORT=3000
VPP_CLIENT_PORT=8080

# ---------------------------------------------------------------------------
# Grid protocols (services/grid-protocols, services/modbus-poller)
# The shared secret authenticates both directions between the server and the
# protocol services (HMAC-SHA256 over "<unix timestamp>.<body>"). Without the
# service URL the server refuses to command charge points rather than
# reporting dispatches that never reached hardware.
# ---------------------------------------------------------------------------
GRID_PROTOCOL_SHARED_SECRET=
GRID_PROTOCOL_SERVICE_URL=
GRID_PROTOCOL_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Control validity and degraded-mode fallback
# Every setpoint the platform sends is bounded in time and carries a declared
# fallback, so hardware never holds an optimizer setpoint nobody is refreshing.
#
# GRID_CONTROL_MAX_VALIDITY_SECONDS caps how long any single control may claim.
# GRID_CONTROL_FALLBACK_LIMIT_W is the safe signed watts a `safe_limit` fallback
#   applies (negative = charge/import). There is no default: a guessed limit
#   would either strand an asset at zero or leave it exporting, so dispatches
#   that rely on it fail loudly while it is unset.
# GRID_CONTROL_SWEEP_MS enables the in-process fallback sweeper. Leave it unset
#   when a dedicated worker runs the sweep instead.
# P2P_TRANSFER_WINDOW_SECONDS is the window a settled P2P trade is dispatched
#   over: traded Wh divided by this window is the seller's export setpoint, and
#   the same window expires it. It must stay within the maximum validity above,
#   and a trade needing more power than the asset is rated for is refused rather
#   than dispatched at a rate the hardware cannot hold.
# ---------------------------------------------------------------------------
GRID_CONTROL_MAX_VALIDITY_SECONDS=3600
GRID_CONTROL_FALLBACK_LIMIT_W=
GRID_CONTROL_SWEEP_MS=
P2P_TRANSFER_WINDOW_SECONDS=3600
