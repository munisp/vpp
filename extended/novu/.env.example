# =============================================================================
# Novu (self-hosted) environment - copy the variables you need into the .env
# file you pass to docker compose (repo-root .env, or --env-file).
# Generate the secrets BEFORE first boot:
#   openssl rand -hex 32   # NOVU_JWT_SECRET
#   openssl rand -hex 16   # NOVU_STORE_ENCRYPTION_KEY (must be exactly 32 chars)
#   openssl rand -hex 32   # NOVU_SECRET_KEY
#   openssl rand -hex 24   # NOVU_MONGO_PASSWORD
# These are fail-loud: docker-compose.extended.yml refuses to render without them.
# =============================================================================

# REQUIRED secrets (no defaults, by design)
NOVU_JWT_SECRET=
NOVU_STORE_ENCRYPTION_KEY=
NOVU_SECRET_KEY=
NOVU_MONGO_PASSWORD=

# Strongly recommended once the first admin account exists:
# (Novu dashboard allows open self-registration by default on first boot;
#  create your account, then set this true and recreate novu-api)
# NOVU_DISABLE_USER_REGISTRATION=true   # (not wired by default; see README)

# Runtime mode: 'production' for real use, 'local' for Novu's dev defaults
NOVU_NODE_ENV=production

# Public URLs (browser-facing). Adjust to your hostnames in real deployments.
NOVU_API_ROOT_URL=http://localhost:3100
NOVU_FRONT_BASE_URL=http://localhost:4200
NOVU_WS_HOSTNAME=http://localhost:3102

# Attachment storage: defaults to the existing platform MinIO on vpp-network.
# Create the bucket once (README section 6). To use real AWS S3 instead,
# set NOVU_S3_ENDPOINT empty and provide real AWS_* credentials in the compose file.
NOVU_S3_ENDPOINT=http://minio:9000
NOVU_S3_BUCKET=novu-local
NOVU_S3_REGION=us-east-1

# Platform-side adapter contract (consumed by the TS coder's Novu adapter,
# NOT by this compose file):
#   NOVU_BACKEND_URL=http://localhost:3100   (base URL of novu-api)
#   NOVU_API_KEY=<API key from Novu dashboard -> Settings -> API Keys>
