{
  "dashboard": {
    "title": "VPP Platform Monitoring",
    "tags": ["vpp", "iot", "mqtt", "fluvio"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Message Throughput",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(mqtt_messages_received_total[1m])",
            "legendFormat": "MQTT Received"
          },
          {
            "expr": "rate(fluvio_messages_published_total[1m])",
            "legendFormat": "Fluvio Published"
          },
          {
            "expr": "rate(messages_processed_total[1m])",
            "legendFormat": "Processed"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Processing Latency (p95)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(message_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "{{consumer}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Error Rates",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(fluvio_publish_errors_total[1m])",
            "legendFormat": "Fluvio Publish Errors"
          },
          {
            "expr": "rate(processing_errors_total[1m])",
            "legendFormat": "Processing Errors - {{consumer}}"
          },
          {
            "expr": "rate(database_errors_total[1m])",
            "legendFormat": "Database Errors"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Connection Status",
        "type": "stat",
        "targets": [
          {
            "expr": "mqtt_connection_status",
            "legendFormat": "MQTT"
          },
          {
            "expr": "database_connection_status",
            "legendFormat": "Database"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 5,
        "title": "Worker Queue Size",
        "type": "graph",
        "targets": [
          {
            "expr": "worker_queue_size",
            "legendFormat": "Queue Size"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 6,
        "title": "Database Operations",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(database_inserts_total[1m])",
            "legendFormat": "Inserts - {{table}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      },
      {
        "id": 7,
        "title": "System CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "100 - (avg by (instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "{{instance}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}
      },
      {
        "id": 8,
        "title": "System Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
            "legendFormat": "{{instance}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
