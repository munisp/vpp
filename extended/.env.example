# =============================================================================
# Extended stack shared environment (everything EXCEPT Novu, which lives in
# extended/novu/.env.example). Copy into your compose .env and edit.
# =============================================================================

# --- Networks (compose-project-derived names; project "vpp" is the default) ---
# monitoring network created by docker-compose.monitoring.yml
MONITORING_NETWORK_NAME=vpp_monitoring
# vpp-network created by docker-compose.middleware.yml / docker-compose.external-services.yml
VPP_NETWORK_NAME=vpp_vpp-network

# --- OpenSearch (REQUIRED, fail-loud; must be strong or OpenSearch exits) ---
# e.g. openssl rand -base64 18 | tr -d '=+/'
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# --- MinIO (existing lakehouse; defaults match docker-compose.middleware.yml) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEHOUSE_ENDPOINT=http://minio:9000
LAKEHOUSE_BUCKET=vpp-data

# --- open-appsec (optional) ---
# APPSEC_VERSION pins all ghcr.io/openappsec/* images together.
APPSEC_VERSION=latest
# Leave APPSEC_AGENT_TOKEN empty for standalone (locally managed) mode.
# Set it to a profile token from https://my.openappsec.io to manage centrally.
APPSEC_AGENT_TOKEN=
APPSEC_AUTO_POLICY_LOAD=false
APPSEC_USER_EMAIL=
APPSEC_DB_PASSWORD=appsec-local-dev
APPSEC_DB_USER=postgres
