{
  "dashboard": {
    "title": "VPP Service Health",
    "tags": ["vpp", "health", "middleware", "infrastructure"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Kafka Messages Published (Rate)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vpp_kafka_messages_published_total[5m])",
            "legendFormat": "{{topic}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Kafka Publish Errors",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vpp_kafka_publish_errors_total[5m])",
            "legendFormat": "{{topic}} - {{error_type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "Redis Operations (Rate)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vpp_redis_operations_total[5m])",
            "legendFormat": "{{operation}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "id": 4,
        "title": "Redis Errors",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vpp_redis_errors_total[5m])",
            "legendFormat": "{{operation}} - {{error_type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
      },
      {
        "id": 5,
        "title": "TigerBeetle Transactions (Rate)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vpp_tigerbeetle_transactions_total[5m])",
            "legendFormat": "{{transaction_type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
      },
      {
        "id": 6,
        "title": "TigerBeetle Errors",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vpp_tigerbeetle_errors_total[5m])",
            "legendFormat": "{{transaction_type}} - {{error_type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
      },
      {
        "id": 7,
        "title": "Alerts Generated by Severity",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vpp_alerts_generated_total[5m])",
            "legendFormat": "{{alert_severity}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }
      },
      {
        "id": 8,
        "title": "Anomalies Detected by Type",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(vpp_anomalies_detected_total[5m])",
            "legendFormat": "{{anomaly_type}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }
      },
      {
        "id": 9,
        "title": "Kafka Health",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(vpp_kafka_messages_published_total[5m])) / (sum(rate(vpp_kafka_messages_published_total[5m])) + sum(rate(vpp_kafka_publish_errors_total[5m]))) * 100"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 32 }
      },
      {
        "id": 10,
        "title": "Redis Health",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(vpp_redis_operations_total[5m])) / (sum(rate(vpp_redis_operations_total[5m])) + sum(rate(vpp_redis_errors_total[5m]))) * 100"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 32 }
      },
      {
        "id": 11,
        "title": "TigerBeetle Health",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(vpp_tigerbeetle_transactions_total[5m])) / (sum(rate(vpp_tigerbeetle_transactions_total[5m])) + sum(rate(vpp_tigerbeetle_errors_total[5m]))) * 100"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 32 }
      },
      {
        "id": 12,
        "title": "Overall System Health",
        "type": "gauge",
        "targets": [
          {
            "expr": "(sum(rate(vpp_workflows_completed_total[5m])) / (sum(rate(vpp_workflows_completed_total[5m])) + sum(rate(vpp_workflows_failed_total[5m])))) * 100"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 32 }
      }
    ],
    "refresh": "10s",
    "schemaVersion": 27,
    "version": 1
  }
}
