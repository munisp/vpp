# syntax=docker/dockerfile:1

# ---------- Build stage ----------
FROM node:20-alpine AS builder

WORKDIR /app

# pnpm via corepack (version pinned by packageManager in package.json)
RUN corepack enable

# Install all dependencies (incl. devDeps needed for the build).
# patches/ is required by pnpm.patchedDependencies.
# NOTE: --no-frozen-lockfile until pnpm-lock.yaml is regenerated to include
# helmet and express-rate-limit (run: pnpm install --lockfile-only).
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --no-frozen-lockfile

# Copy sources and build the client bundle and the server bundle (dist/)
COPY . .
RUN pnpm build

# ---------- Runtime stage ----------
FROM node:20-alpine AS runtime

WORKDIR /app

RUN apk add --no-cache dumb-init \
  && corepack enable

# Production dependencies only (bundle is built with --packages=external)
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --prod --no-frozen-lockfile \
  && pnpm store prune

# Built artifacts: dist/index.js (server) and dist/public (static client)
COPY --from=builder /app/dist ./dist

ENV NODE_ENV=production \
    PORT=3000
EXPOSE 3000

# Run as the unprivileged node user
USER node

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/health" >/dev/null 2>&1 || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]
